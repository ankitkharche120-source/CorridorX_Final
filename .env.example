# ==================================================
# CorridorX Platform Environment Variables
# ==================================================

# --------------------------------------------------
# Required Server Configuration
# --------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
DATABASE_URL=./data/database.json

# --------------------------------------------------
# Google Maps Platform (Server & Client Services)
# --------------------------------------------------
# Client-side (Vite public key for Maps JS SDK)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere
VITE_BACKEND_URL=http://localhost:5000

# Server-side (Protected Google API Keys)
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere
GOOGLE_ROUTES_API_KEY=AIzaSyYourGoogleRoutesApiKeyHere
GOOGLE_PLACES_API_KEY=AIzaSyYourGooglePlacesApiKeyHere
GOOGLE_ROADS_API_KEY=AIzaSyYourGoogleRoadsApiKeyHere

# --------------------------------------------------
# Optional External Adapters & Telemetry
# --------------------------------------------------
# WhatsApp Cloud API (Automated bystander / attendant alerts)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Twilio SMS / Verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Firebase Cloud Messaging (Web Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Municipal Traffic Signal Controller Interface (NTCIP / SCATS / ITMS)
TRAFFIC_SIGNAL_API_URL=
TRAFFIC_SIGNAL_API_KEY=

# Roadside Digital LED Boards (Variable Message Signs - VMS)
ROAD_BOARD_API_URL=
ROAD_BOARD_API_KEY=

# --------------------------------------------------
# Mode & Corridor Engine Configuration
# --------------------------------------------------
CORRIDOR_MODE=REAL
PREPARING_DISTANCE=500
ACTIVE_DISTANCE=200
PASSED_DISTANCE=50
